# --- Database (Postgres) ---
# Any reachable Postgres works; on Vercel use e.g. Neon/Vercel Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poorstudents"

# --- Auth.js ---
# The canonical URL of the app. http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# --- Magic-link email (optional in dev) ---
# SMTP connection string. If unset, magic links are printed to the server
# console instead of being emailed — handy for local development.
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="PoorStudents <hello@poorstudents.eu>"

# --- Admin ---
# Comma-separated list of emails allowed into /admin.
# The first address also receives new merchant-lead notifications.
ADMIN_EMAILS="you@example.com"
