# Postgres connection string (Neon/Vercel Postgres in production, local Postgres in dev).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poorstudents"

# Canonical URL of the deployed app (http://localhost:3000 in dev).
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing auth tokens — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Resend API key for magic-link + notification email; if unset (dev only), emails are printed to the server console instead.
RESEND_API_KEY=""

# From address for all outgoing email — must be on a domain verified in Resend.
EMAIL_FROM="PoorStudents <hello@poorstudents.eu>"

# Comma-separated emails allowed into /admin; the first one also receives merchant-lead notifications.
ADMIN_EMAILS="you@example.com"
